rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function member() { return signedIn(); }
    function pastor() { return signedIn() && request.auth.token.pastor == true; }
    match /users/{uid} {
      allow read: if self(uid) || pastor();
      allow create: if self(uid) && request.resource.data.keys().hasOnly(['name','email','status','createdAt']) && request.resource.data.status == 'active';
      allow update, delete: if false;
    }
    match /quizzes/{id} {
      allow read: if pastor() || (member() && resource.data.status in ['published','closed']);
      allow write: if false;
      match /questions/{questionId} {
        allow read: if pastor() || (member() && get(/databases/$(database)/documents/quizzes/$(id)).data.status == 'published');
        allow write: if false;
      }
    }
    match /attempts/{id} { allow read: if pastor() || (signedIn() && resource.data.uid == request.auth.uid); allow write: if false; }
    match /results/{id} { allow read: if pastor() || (signedIn() && resource.data.uid == request.auth.uid && resource.data.published == true); allow write: if false; }
    match /securityEvents/{id} { allow read: if pastor(); allow write: if false; }
    match /auditLogs/{id} { allow read: if pastor(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
